# Modelo das variáveis de ambiente do L1d3r (Fin4nce).
# Copie para ".env" e preencha SÓ com valores de TESTE (bot, banco e chaves de teste).
# Nunca faça commit do .env e nunca coloque valores reais neste arquivo.

# --- Obrigatórias ---------------------------------------------------------
# Token do bot do Telegram (crie um bot de teste no @BotFather)
TOKEN=seu_token_do_bot_de_teste

# Banco Turso de TESTE (nunca o de produção)
TURSO_DATABASE_URL=libsql://seu-banco-de-teste.turso.io
TURSO_AUTH_TOKEN=seu_token_do_banco_de_teste

# IA do registro de gastos: Gemini (reserva) e, opcionalmente, DeepSeek (principal)
GEMINI_API_KEY=sua_chave_do_gemini
DEEPSEEK_API_KEY=

# --- Mini App --------------------------------------------------------------
# URL HTTPS pública da API, terminando em /app/ (por exemplo, um túnel ngrok)
URL_MINI_APP=https://seu-endereco-publico/app/

# --- Administração e assinaturas ------------------------------------------
# IDs numéricos do Telegram dos administradores, separados por vírgula
ADMIN_IDS=
# 1 liga as assinaturas (Telegram Stars); 0 desliga
ASSINATURAS_LIGADAS=0
# Registros por IA por pessoa por dia
LIMITE_IA_DIA=17
# Preço do plano Pro, em Stars, por 30 dias
PRECO_PRO_STARS=150

# --- Controle de cadastro (opcionais) --------------------------------------
# 0 fecha o cadastro de contas novas
CADASTRO_ABERTO=1
# Testes novos por dia (vale com as assinaturas ligadas)
LIMITE_TESTES_DIA=20

# --- Desenvolvimento (opcional) --------------------------------------------
# 1 habilita a página de diagnóstico /teste/ (nunca em produção)
# PAGINA_DIAGNOSTICO=1
